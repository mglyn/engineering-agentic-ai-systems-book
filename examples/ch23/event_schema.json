{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book session event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "event_id",
    "sequence",
    "occurred_ms",
    "kind",
    "operation_id",
    "ticket_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_ms": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "opened",
        "started",
        "paused",
        "resumed",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "ticket_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  }
}
