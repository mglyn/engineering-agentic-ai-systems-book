{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Teaching media envelope v1",
  "type": "object",
  "required": [
    "event_id",
    "session_id",
    "turn_id",
    "kind",
    "captured_ms",
    "received_ms",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "image",
        "file",
        "speech"
      ]
    },
    "captured_ms": {
      "type": "integer",
      "minimum": 0
    },
    "received_ms": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "speech"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "ref",
              "side",
              "revision",
              "final",
              "speaker"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "side": {
                "enum": [
                  "左",
                  "右"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "final": {
                "type": "boolean"
              },
              "speaker": {
                "enum": [
                  "user",
                  "unknown"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "ref",
              "objects"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "objects": {
                "type": "object",
                "required": [
                  "左",
                  "右"
                ],
                "properties": {
                  "左": {
                    "type": "string",
                    "minLength": 1
                  },
                  "右": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
